# ── База данных ──────────────────────────────────────────────────────────
DATABASE_URL=sqlite+aiosqlite:///./flowers.db
# Для PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/flowers

# ── Приложение ───────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,https://your-production-domain.com
APP_ENV=development

# ── Уведомления ──────────────────────────────────────────────────────────
SMS_API_KEY=your_sms_api_key_here
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_smtp_password_here

# ── Stripe (основной платёжный шлюз) ────────────────────────────────────
# Тестовые ключи начинаются с sk_test_ и pk_test_
# Боевые ключи начинаются с sk_live_ и pk_live_
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
# Получить в Stripe Dashboard → Developers → Webhooks → signing secret
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Валюта по умолчанию (ISO 4217)
STRIPE_CURRENCY=rub

# ── ЮКасса (опционально, для РФ-рынка) ──────────────────────────────────
YOKASSA_ENABLED=false
YOKASSA_SHOP_ID=your_shop_id_here
YOKASSA_SECRET_KEY=your_yokassa_secret_key_here
YOKASSA_RETURN_URL=https://your-domain.com/payment/success

# ── Безопасность ─────────────────────────────────────────────────────────
# Секрет для подписи внутренних токенов (минимум 32 символа)
SECRET_KEY=change_this_to_a_random_32_char_string_minimum